# Google AdMob Ad Unit IDs
# Replace these with your real Ad Unit IDs from AdMob console

# iOS Ad Unit IDs are intentionally NOT set here.
# The app (hooks/use-admob.ts) automatically uses Google TEST IDs in dev
# (__DEV__) and the real PRODUCTION IDs in release builds. Setting them here
# would force real ads in development, which violates AdMob policy.
#
# Real iOS production IDs (for reference, baked into hooks/use-admob.ts):
#   Banner:       ca-app-pub-2649396512295570/1197980952
#   Interstitial: ca-app-pub-2649396512295570/5797864651

# Android Ad Unit IDs (format: ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY)
EXPO_PUBLIC_ADMOB_BANNER_ID_ANDROID=ca-app-pub-3940256099942544/6300978111
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID_ANDROID=ca-app-pub-3940256099942544/1033173712

# Note: The IDs above are Google's test IDs
# Get your real IDs from: https://apps.admob.google.com
